{
  "name": "trading-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lightweight T-Invest API trading terminal (Tauri v2 + React + PWA)",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"cross-env NODE_EXTRA_CA_CERTS=contracts/certs/russian-trusted-root-ca.pem tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "cross-env NODE_EXTRA_CA_CERTS=contracts/certs/russian-trusted-root-ca.pem tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "cross-env NODE_EXTRA_CA_CERTS=contracts/certs/russian-trusted-root-ca.pem node dist-server/server/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run build:server && npm run check:secrets",
    "diagnose": "cross-env NODE_EXTRA_CA_CERTS=contracts/certs/russian-trusted-root-ca.pem node scripts/diagnose.mjs",
    "start:debug": "cross-env LOG_LEVEL=debug DEBUG_TINKOFF=1 NODE_EXTRA_CA_CERTS=contracts/certs/russian-trusted-root-ca.pem node dist-server/server/index.js"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.79.0",
    "lightweight-charts": "^5.3.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@tauri-apps/api": "^2.12.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "fastify": "^5.12.8",
    "@fastify/static": "^10.1.12",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
